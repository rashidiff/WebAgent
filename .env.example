LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
LLM_MAX_TOKENS=2048
MAX_AGENT_STEPS=15
ACTION_TIMEOUT_SECONDS=40
MAX_DOM_ELEMENTS=150
MAX_ACTIONS_PER_MINUTE=30
ALLOW_PRIVATE_NETWORKS=true
CAPTURE_SCREENSHOTS=false
HISTORY_RETENTION_DAYS=7
MAX_WEBSOCKET_MESSAGE_BYTES=512000

# Configure exactly the provider key selected above.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local use works without authentication. Enable it on a shared machine or remote host.
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=false
AGENT_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=
# Required only when AUTH_REQUIRED=true. Use the exact Chrome extension origin.
WS_ALLOWED_ORIGINS=
AGENT_DB_PATH=
