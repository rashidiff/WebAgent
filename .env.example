LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
LLM_MAX_TOKENS=2048
MAX_AGENT_STEPS=15
ACTION_TIMEOUT_SECONDS=40
MAX_DOM_ELEMENTS=150
REQUIRE_ACTION_APPROVAL=true
MAX_ACTIONS_PER_MINUTE=30
ALLOW_PRIVATE_NETWORKS=false
CAPTURE_SCREENSHOTS=false

# Configure exactly the provider key selected above.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Keep the backend local by default. Set a strong random value before exposing it
# outside localhost.
HOST=127.0.0.1
PORT=8000
AGENT_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=chrome-extension://*
AGENT_DB_PATH=
