# Copy this file to .env and fill in the values you need.

# Which LLM provider to use: gemini | openai | anthropic | deepseek
LLM_PROVIDER=deepseek

# Optional: override the default model for the chosen provider
LLM_MODEL_NAME=deepseek-chat

# Optional: cap on output tokens per LLM call (applies to all providers)
LLM_MAX_TOKENS=2048

# Agent loop controls
# `MAX_AGENT_STEPS` counts executed browser tool calls, not raw model turns.
MAX_AGENT_STEPS=15
ACTION_TIMEOUT_SECONDS=40
# Keep this aligned with `extension/content.js` DOM_ELEMENT_BUDGET.
MAX_DOM_ELEMENTS=150
REQUIRE_ACTION_APPROVAL=true

# Provider API keys (only the one matching LLM_PROVIDER is required)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# WebSocket server bind settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
AGENT_DB_PATH=

# Optional: require this local token for WebSocket and session history endpoints.
# Leave empty to disable local auth.
AGENT_AUTH_TOKEN=

# Optional: comma-separated list of origins allowed to call the GET /sessions* HTTP
# endpoints from browser JS (CORS). Leave empty (default) to block all cross-origin
# access to session history, since it's local-only debugging data.
CORS_ALLOWED_ORIGINS=
