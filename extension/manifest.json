{
  "manifest_version": 3,
  "name": "Web Browser AI Agent",
  "version": "1.1.0",
  "description": "A local Web Browser AI Agent that acts on the active webpage.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Browser Agent Sidepanel"
  }
}
